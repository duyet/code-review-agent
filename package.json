{
  "name": "code-review-agent",
  "version": "1.0.0",
  "description": "AI-powered code review GitHub Action using Claude Agent SDK",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.cjs --format cjs --target node --external @actions/core --external @actions/github --external zod",
    "dev": "bun run src/index.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["github-action", "code-review", "claude", "ai", "bun"],
  "author": "duyet",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
