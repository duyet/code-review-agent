{
  "name": "code-review-agent",
  "version": "1.0.0",
  "description": "AI-powered code review GitHub Action using Claude Agent SDK",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target node --platform node --format cjs --external @actions/core --external @actions/github --external @anthropic-ai/claude-agent-sdk --external zod",
    "dev": "bun run src/index.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["github-action", "code-review", "claude", "ai", "bun"],
  "author": "duyet",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
